{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pandora-vizuals",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "out",
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pandora-vizuals-storage"
    }
  ]
}
